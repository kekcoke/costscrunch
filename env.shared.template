# ─── env.shared.template ─────────────────────────────────────────────────────
# Copy to .env.shared (gitignored) and fill in real values.
# .env.shared is symlinked into each worktree by .claude/hooks/syslink-configs.sh.
# Worktree-local vars (Vite/SAM ports) are generated by the hook; do not add them here.

# ─── Environment & Global Settings ──────────────────────────────────────────
ENVIRONMENT=dev
PREFIX=costscrunch-${ENVIRONMENT}
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
MOCK_AUTH=true

# ─── Logging & Observability (Powertools) ───────────────────────────────────
LOG_LEVEL=SILENT
DEBUG_EVENT=true
POWERTOOLS_SERVICE_NAME=costscrunch
POWERTOOLS_METRICS_NAMESPACE=costscrunch/${ENVIRONMENT}
POWERTOOLS_LOGGER_LOG_EVENT=false
ALARM_LAMBDA_ERROR_RATE_THRESHOLD=5

# ─── Data & Storage (DynamoDB & S3) ─────────────────────────────────────────
TABLE_NAME_MAIN=${PREFIX}-main
TABLE_NAME_CONNECTIONS=${PREFIX}-connections
BUCKET_UPLOADS_NAME=${PREFIX}-uploads-000000000000
BUCKET_PROCESSED_NAME=${PREFIX}-processed-000000000000
BUCKET_RECEIPTS_NAME=${PREFIX}-receipts-000000000000
BUCKET_QUARANTINE_NAME=${PREFIX}-quarantine-000000000000
BUCKET_ASSETS_NAME=${PREFIX}-assets-000000000000

# ─── Events & Messaging (EventBridge, SNS, SQS) ─────────────────────────────
EVENT_BUS_NAME=${PREFIX}-events
TEXTRACT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:costscrunch-dev-textract-completion
TEXTRACT_ROLE_ARN=arn:aws:iam::000000000000:role/costscrunch-dev-textract-sns
SCAN_DLQ_URL=http://localhost:4566/000000000000/costscrunch-dev-scan-dlq
SCAN_QUEUE_URL=http://localhost:4566/000000000000/costscrunch-dev-scan-queue
FROM_EMAIL=noreply@costscrunch.dev

# ─── Auth, Cache & APIs (Cognito, Redis, WebSocket) ─────────────────────────
USER_POOL_ID=${AWS_REGION}_xxxxxxxx
REDIS_HOST=${PREFIX}.elasticache.amazonaws.com
REDIS_PORT=6379
WEBSOCKET_ENDPOINT=wss://costscrunch.com/socket

# ─── IAM & Third-Party Services (Bedrock, Textract) ─────────────────────────
BEDROCK_MODEL_ID=foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0

# ─── Secrets ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=YOUR_GITHUB_PAT_HERE
