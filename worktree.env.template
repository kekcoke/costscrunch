# ─── worktree.env.template ───────────────────────────────────────────────────
# Documents worktree-local env vars. syslink-configs.sh generates these with
# dynamic port scanning and appends them to each worktree's .env.dev.
# Do NOT add vars here that belong in .env.shared (shared across all worktrees).

# Vite dev server port (range 3000-3009; hook picks a free one)
VITE_APP_URL=http://localhost:3000

# SAM CLI local start-api port (range 3010-3099; hook picks a free one)
# Used by dev:opt3. If you use Express (dev:opt2), this does not matter.
VITE_API_URL=http://localhost:3010
